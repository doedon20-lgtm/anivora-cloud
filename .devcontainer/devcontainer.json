{
  "name": "AniVora Cloud",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "forwardPorts": [8000, 8888],

  "portsAttributes": {
    "8000": {
      "label": "AniVora Cloud"
    },
    "8888": {
      "label": "AniVora Notebook"
    }
  },

  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
